# PanelPals V2 Backend Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]

# Google Vision API (Section 6: OCR Pipeline)
# Path to your Google Cloud service account JSON credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json
# Max number of images to process in a single batch request
OCR_MAX_PARALLEL_REQUESTS=10
# Stack consecutive panels into strips up to this height (px) before OCR:
# ~8x fewer billable Vision units, ~2% fewer words read identically. 0 = off
OCR_STITCH_MAX_HEIGHT=8000
OCR_STITCH_JPEG_QUALITY=85
GOOGLE_VISION_MAX_BATCH_SIZE=10

# ElevenLabs API (Section 8: Text-to-Speech)
# Get your API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=N2lVS1w4EtoT3dr4eOWO
ELEVENLABS_MAX_PARALLEL_REQUESTS=5
TTS_MAX_RETRIES=3

# Limits on third-party APIs (in case a provider is slow, misbehaving or compromised)
EXTERNAL_API_TIMEOUT_SECONDS=30
OCR_MAX_WORDS_PER_IMAGE=3000
# Largest audio clip accepted from ElevenLabs (~3 min of MP3)
TTS_MAX_AUDIO_BYTES=3000000
# Max characters sent to TTS per chapter (caps credit spend); 0 disables
TTS_MAX_CHARS_PER_CHAPTER=30000

# Audio Processing (Section 9: Audio Stitching)
AUDIO_PAUSE_DURATION_MS=500
AUDIO_OUTPUT_FORMAT=wav
AUDIO_SAMPLE_RATE=44100

# Text Bubble Grouping (Section 6.1)
# Max vertical gap between lines in the same bubble (pixels)
# Typical line spacing in webtoons: 60-100 pixels
BUBBLE_MAX_VERTICAL_GAP=100
# Max horizontal center shift for lines in the same bubble (pixels)
BUBBLE_MAX_CENTER_SHIFT=150

# Dialogue/Background Classifier
# "model" uses the trained ML classifier, "heuristic" the weighted formula.
# Falls back to heuristic automatically if the model file is missing.
CLASSIFIER_MODE=model
ML_MODEL_PATH=models/best_model.joblib
# Min P(dialogue) to keep a bubble. Lower keeps more dialogue at the cost of
# reading more sound effects aloud (0.4 chosen from cross-validation).
ML_THRESHOLD=0.4

# Save every classified bubble to backend/ml/ml_data/raw during requests (stores users' text).
# Leave off in production; use `python -m backend.ml.collect_ml_data` to gather training data.
ML_COLLECT_DATA=false

# Expressive TTS (ElevenLabs v3/v4)
# Sentence case + kept ellipses for all-caps bubbles (caps are read as shouting)
TTS_SENTENCE_CASE=true
# Sound words like SOB / GIGGLE / SIGH become audio tags ([crying], [chuckles], [sighs])
TTS_AUDIO_TAGS=true

# Security & Rate Limiting (Section 5.2)
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_REQUEST=200
# Max width x height per image (guards against decompression bombs)
MAX_IMAGE_PIXELS=40000000
# Requests per minute per client; 0 disables
RATE_LIMIT_PER_MINUTE=10
# Accepted X-API-Key values. Required in production (DEBUG=false);
# without any, /process/chapter returns 503. Generate with: openssl rand -hex 32
API_KEYS=[]